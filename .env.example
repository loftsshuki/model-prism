# Model Prism — environment variables
# Copy to .env.local for the web app; export in your shell for the CLI.

# Web app (Next.js) — server side
DATABASE_URL=postgres://user:pass@host/db          # Neon/Postgres for run history + telemetry (optional locally)
MODEL_PRISM_ADMIN_TOKEN=                            # If set, clients must send it as x-model-prism-token (enter it in Settings)

# CLI plan review (scripts/review-plan.ts) — the whole pipeline bills to OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...

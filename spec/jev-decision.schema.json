{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/loftsshuki/model-prism/spec/jev-decision.schema.json",
  "title": "Jev Decision Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specVersion",
    "primitive",
    "key",
    "mode",
    "baselineDecision",
    "effectiveDecision",
    "action"
  ],
  "properties": {
    "specVersion": { "const": "jev-decision-spec/v1" },
    "primitive": {
      "enum": ["classify", "verify", "gate", "dedupe", "rank", "shortlist", "route"]
    },
    "key": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["off", "shadow", "assist", "enforce"] },
    "answer": {},
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "probabilities": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "baselineDecision": {},
    "effectiveDecision": {},
    "action": {
      "enum": [
        "baseline",
        "observed",
        "expanded",
        "promoted",
        "enforced",
        "preserved",
        "suppressed",
        "fallback"
      ]
    },
    "latencyMs": { "type": "number", "minimum": 0 },
    "costUsd": { "type": "number", "minimum": 0 },
    "generationId": { "type": "string" },
    "evaluatorVersion": { "type": "string" },
    "error": { "type": "string" }
  }
}
